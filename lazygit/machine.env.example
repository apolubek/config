# Machine-local lazygit settings.
#
# Copy this file to `machine.env` (gitignored) and change the backend/model per
# machine. Environment variables take precedence over this file.
#
# Backend: claude (default) or pi.
# Model:
#   - claude defaults to `haiku` when unset.
#   - pi uses its configured default model when unset.
#
# Claude examples:
#   LAZYGIT_AI_COMMIT_BACKEND=claude
#   LAZYGIT_AI_COMMIT_MODEL=haiku
#
# Pi examples:
#   LAZYGIT_AI_COMMIT_BACKEND=pi
#   LAZYGIT_AI_COMMIT_MODEL=deepseek/deepseek-v4.1-flash-1017
LAZYGIT_AI_COMMIT_BACKEND=pi
LAZYGIT_AI_COMMIT_MODEL=
