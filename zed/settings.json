// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports" },
        "language_server",
      ],
      "language_servers": ["vtsls", "oxlint", "oxfmt"],
      // "language_servers": ["tsgo", "vtsls", "eslint"],
      // "language_servers": ["tsgo", "typescript-language-server"],
    },
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "model": "claude-fable-5[1m]"
      },
      "type": "registry",
    },
  },
  "disable_ai": false,
  "show_edit_predictions": true,
  "inlay_hints": {
    "enabled": false,
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": false,
  "minimap": {
    "show": "always",
  },
  "buffer_font_family": "FiraMono Nerd Font Mono",
  "relative_line_numbers": "wrapped",
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-5-thinking",
    },
    "model_parameters": [],
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark Soft",
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 500,
  },
}
