[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-f": [
        "action::Sequence",
        ["vim::PageDown", "editor::ScrollCursorCenter"],
      ],
      "ctrl-b": [
        "action::Sequence",
        ["vim::PageUp", "editor::ScrollCursorCenter"],
      ],
      "ctrl-u": [
        "action::Sequence",
        ["vim::ScrollUp", "editor::ScrollCursorCenter"],
      ],
      "ctrl-d": [
        "action::Sequence",
        ["vim::ScrollDown", "editor::ScrollCursorCenter"],
      ],
      "ctrl-shift-u": "vim::ScrollUp",
      "ctrl-shift-d": "vim::ScrollDown",
      "n": [
        "action::Sequence",
        ["vim::MoveToNextMatch", "editor::ScrollCursorCenter"],
      ],
      "shift-n": [
        "action::Sequence",
        ["vim::MoveToPreviousMatch", "editor::ScrollCursorCenter"],
      ],
    },
  },
  {
    "context": "(VimControl && !menu) || EmptyPane || SharedScreen",
    "bindings": {
      // Lazy git
      "space": null, // Disable the default action vim::WrappingRight
      "space g g": [
        "task::Spawn",
        {
          "task_name": "Lazygit",
          "reveal_target": "center",
        },
      ],
      // Side panel toggle
      "space e": "vim::ToggleProjectPanelFocus",
      // Television full text search
      "space f g": [
        "task::Spawn",
        {
          "task_name": "Text search",
          "reveal_target": "center",
        },
      ],
      // Television file finder
      "space f f": [
        "task::Spawn",
        {
          "task_name": "File finder",
          "reveal_target": "center",
        },
      ],
      "space a e": [
        "task::Spawn",
        {
          "task_name": "Code review (critique)",
          "reveal_target": "center",
        },
      ],
      "space a r": [
        "task::Spawn",
        {
          "task_name": "Code review (codex)",
          "reveal_target": "center",
        },
      ],
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "q": "workspace::ToggleLeftDock",
      "space e": "vim::ToggleProjectPanelFocus",
      "f": "project_panel::NewSearchInDirectory",
      // collapse all and expand root
      "space c a": [
        "action::Sequence",
        [
          "project_panel::CollapseAllEntries",
          "project_panel::ScrollCursorTop",
          "menu::SelectFirst",
          "project_panel::ExpandSelectedEntry",
        ],
      ],
      // Navigate between panel
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-u": "terminal::ScrollPageUp",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-d": "terminal::ScrollPageDown",
    },
  },
]
